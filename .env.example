# Copy to .env and fill in. Everything has a default; with no .env the app
# still starts and `make eval` replays recorded model outputs.

# LLM: any OpenAI-compatible endpoint.
# LLM_PROVIDER is one of: cerebras, groq, openai, openrouter.
# For any other endpoint, set LLM_BASE_URL (it overrides the provider's default URL).
LLM_PROVIDER=groq
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Host ports (change if they clash with something already running)
DB_HOST_PORT=5433
APP_HOST_PORT=8000
